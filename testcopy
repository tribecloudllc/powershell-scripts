# ============================================================
# Copy bios/raw_files: PRP -> PROD via AzCopy, two SPNs, TWO-HOP
# (client-side relay: source firewall blocks server-side S2S copy)
#   - SOURCE SPN:      Storage Blob Data Reader      on stazpprpwe1ext01
#   - DESTINATION SPN: Storage Blob Data Contributor on stazpprodwe1ext01
# Requires: Az.Accounts, Az.Storage modules; azcopy v10
# ============================================================

# --- 0. Config ---
$TenantId          = "<tenant-id>"

# Source SPN (prp)
$SrcClientId       = "<source-spn-application-id>"
$SrcClientSecret   = "<source-spn-client-secret>"
$SrcAccount        = "stazpprpwe1ext01"
$SrcContainer      = "raw"
$SrcPath           = "bios/raw_files"

# Destination SPN (prod)
$DstClientId       = "<dest-spn-application-id>"
$DstClientSecret   = "<dest-spn-client-secret>"
$DstAccount        = "stazpprodwe1ext01"
$DstContainer      = "raw"

# NOTE: destination is the PARENT folder - azcopy will place 'raw_files' inside it
$DstParentPath     = "bios"

# Local staging directory (needs enough free disk for the full dataset)
$Staging           = "C:\Temp\azcopy_staging"

$SrcUrlBase = "https://$SrcAccount.blob.core.windows.net/$SrcContainer/$SrcPath"
$DstUrl     = "https://$DstAccount.dfs.core.windows.net/$DstContainer/$DstParentPath"

# --- 1. Ensure modules + azcopy ---
foreach ($m in @("Az.Accounts", "Az.Storage")) {
    if (-not (Get-Module -ListAvailable -Name $m)) {
        Install-Module $m -Scope CurrentUser -Force
    }
}
$azcopy = Get-Command azcopy -ErrorAction SilentlyContinue
if (-not $azcopy) {
    Write-Host "AzCopy not found - downloading..." -ForegroundColor Yellow
    $zip = "$env:TEMP\azcopy.zip"; $dir = "$env:TEMP\azcopy"
    Invoke-WebRequest -Uri "https://aka.ms/downloadazcopy-v10-windows" -OutFile $zip
    Expand-Archive -Path $zip -DestinationPath $dir -Force
    $exe = Get-ChildItem -Path $dir -Recurse -Filter azcopy.exe | Select-Object -First 1
    $env:PATH = "$($exe.DirectoryName);$env:PATH"
}
azcopy --version

# --- 2. Mint user-delegation SAS on source (source SPN, read+list, 8h) ---
Write-Host "`n=== Generating source SAS (source SPN) ===" -ForegroundColor Cyan
$sec  = ConvertTo-SecureString $SrcClientSecret -AsPlainText -Force
$cred = New-Object System.Management.Automation.PSCredential($SrcClientId, $sec)
Connect-AzAccount -ServicePrincipal -Credential $cred -Tenant $TenantId | Out-Null

$ctx = New-AzStorageContext -StorageAccountName $SrcAccount -UseConnectedAccount
$sas = New-AzStorageContainerSASToken `
    -Context    $ctx `
    -Name       $SrcContainer `
    -Permission "rl" `
    -StartTime  (Get-Date).AddMinutes(-5) `
    -ExpiryTime (Get-Date).AddHours(8)

if (-not $sas) { Write-Host "SAS generation failed" -ForegroundColor Red; exit 1 }
$sas = $sas.TrimStart('?')
$SrcUrlWithSas = "$SrcUrlBase`?$sas"
Disconnect-AzAccount | Out-Null
Write-Host "Source SAS generated (8h expiry)."

# --- 3. HOP 1: download source -> local staging (client-side, SAS auth) ---
New-Item -ItemType Directory -Path $Staging -Force | Out-Null
Write-Host "`n=== HOP 1: DOWNLOAD to $Staging ===" -ForegroundColor Cyan
azcopy copy $SrcUrlWithSas $Staging --recursive --log-level=INFO
if ($LASTEXITCODE -ne 0) {
    Write-Host "Download FAILED (exit $LASTEXITCODE). Log dir: $env:USERPROFILE\.azcopy" -ForegroundColor Red
    exit $LASTEXITCODE
}
$LocalDir   = Join-Path $Staging "raw_files"   # azcopy created this folder
$localCount = (Get-ChildItem -Path $LocalDir -Recurse -File | Measure-Object).Count
Write-Host "Downloaded files: $localCount"

# --- 4. HOP 2: upload local staging -> destination (dest SPN OAuth) ---
$env:AZCOPY_AUTO_LOGIN_TYPE    = "SPN"
$env:AZCOPY_SPA_APPLICATION_ID = $DstClientId
$env:AZCOPY_SPA_CLIENT_SECRET  = $DstClientSecret
$env:AZCOPY_TENANT_ID          = $TenantId

Write-Host "`n=== HOP 2: UPLOAD to $DstUrl ===" -ForegroundColor Cyan
# uploading folder 'raw_files' into parent 'bios' => lands at bios/raw_files
azcopy copy $LocalDir $DstUrl --recursive --overwrite=true --log-level=INFO
if ($LASTEXITCODE -ne 0) {
    Write-Host "Upload FAILED (exit $LASTEXITCODE). Log dir: $env:USERPROFILE\.azcopy" -ForegroundColor Red
    exit $LASTEXITCODE
}

# --- 5. Verify: compare counts (local vs destination) ---
Write-Host "`n=== VERIFY ===" -ForegroundColor Cyan
$dstList  = azcopy list "https://$DstAccount.dfs.core.windows.net/$DstContainer/$DstParentPath/raw_files" --recursive
$dstCount = ($dstList | Where-Object { $_ -match "INFO: " } | Measure-Object).Count
Write-Host "Local files:       $localCount"
Write-Host "Destination lines: $dstCount (azcopy list output, approx)"

# --- 6. Cleanup ---
Remove-Item Env:\AZCOPY_SPA_CLIENT_SECRET -ErrorAction SilentlyContinue
$cleanup = Read-Host "`nDelete local staging folder $Staging ? (y/n)"
if ($cleanup -eq "y") { Remove-Item -Path $Staging -Recurse -Force }
Write-Host "Done." -ForegroundColor Green
