# ============================================================
# Copy raw_files: PRP -> PROD via Unity Catalog volumes
# Run on a UC-enabled cluster (Single user or Shared access mode)
# Requires UC grants: READ VOLUME on source, WRITE VOLUME on destination
# ============================================================

src = "/Volumes/azp_prp_adapt_01/brz_bios_sys/bios_raw"
dst = "/Volumes/azp_prod_adapt_01/brz_bios_sys/bios_raw"

# --- 1. Read check on source (shows what will be copied) ---
print("Source contents:")
display(dbutils.fs.ls(src))

# --- 2. Write check on destination ---
dbutils.fs.put(dst + "/_access_test", "ok", overwrite=True)
dbutils.fs.rm(dst + "/_access_test")
print("Write access to destination: OK")

# --- 3. Copy (merge: overwrites same-name files, keeps extras in dst) ---
result = dbutils.fs.cp(src, dst, recurse=True)
print(f"Copy completed: {result}")

# --- 4. Verify: top-level counts ---
src_count = len(dbutils.fs.ls(src))
dst_count = len(dbutils.fs.ls(dst))
print(f"Source items: {src_count}, Destination items: {dst_count}")


####

-- 1. The principal that needs WRITE VOLUME (i.e., who you are right now)
SELECT current_user();

-- 2. Who owns the prod volume (they can grant, or a catalog/metastore admin can)
DESCRIBE VOLUME EXTENDED azp_prod_adapt_01.brz_bios_sys.bios_raw;

-- 3. What grants already exist on it (see how others got access — often a group)
SHOW GRANTS ON VOLUME azp_prod_adapt_01.brz_bios_sys.bios_raw;
